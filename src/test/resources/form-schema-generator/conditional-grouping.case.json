{
  "id": "conditional-grouping",
  "description": "FEEL 括号分组：age < 18 or (age > 60 and sex = Female) 编译为外层 anyOf 与内层 allOf。",
  "formDefinition": {
    "formKey": "age-sex-description",
    "version": 3,
    "fields": [
      {
        "key": "age",
        "type": "integer",
        "minimum": 0,
        "maximum": 150
      },
      {
        "key": "sex",
        "type": "string",
        "enum": ["Male", "Female"]
      },
      {
        "key": "description",
        "type": "string",
        "minLength": 50
      }
    ],
    "conditionalRules": [
      {
        "id": "age-sex-requires-description",
        "when": "age < 18 or (age > 60 and sex = \"Female\")",
        "then": {
          "required": ["description"]
        }
      }
    ]
  },
  "expectedSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.example.com/forms/age-sex-description/3",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "age": {
        "type": "integer",
        "minimum": 0,
        "maximum": 150
      },
      "sex": {
        "type": "string",
        "enum": ["Male", "Female"]
      },
      "description": {
        "type": "string",
        "minLength": 50
      }
    },
    "allOf": [
      {
        "if": {
          "anyOf": [
            {
              "required": ["age"],
              "properties": {
                "age": {
                  "exclusiveMaximum": 18
                }
              }
            },
            {
              "allOf": [
                {
                  "required": ["age"],
                  "properties": {
                    "age": {
                      "exclusiveMinimum": 60
                    }
                  }
                },
                {
                  "required": ["sex"],
                  "properties": {
                    "sex": {
                      "const": "Female"
                    }
                  }
                }
              ]
            }
          ]
        },
        "then": {
          "required": ["description"]
        }
      }
    ]
  }
}
